    let slotLocks = {};
    async function watchAd(i) {
      if(slotLocks[i]) return; 
      slotLocks[i] = true;
      const slot = getSlot(i);
      const reward = getSlotReward(i);
      
      try {
        toast('Loading Ad...');
        let success = false;
        
        if (slot.network === 'monetag') {
          const zoneId = String(slot.id);
          if(typeof window['show_' + zoneId] !== 'function'){
            ensureZoneLoaded(zoneId);
            await waitForSDK(zoneId, 4000);
          }
          if (typeof window['show_' + zoneId] === 'function') { 
            await window['show_' + zoneId](); 
            success = true; 
          } else {
            throw new Error("Ad SDK not loaded. Please try again.");
          }
        } 
        else if (slot.network === 'adsgram') {
          if(typeof window.Adsgram === 'undefined'){
            if(!document.getElementById('adsg-script')){
              const sc = document.createElement('script');
              sc.id = 'adsg-script';
              sc.src = 'https://sad.adsgram.ai/js/sad.min.js';
              document.body.appendChild(sc);
              await new Promise(r => setTimeout(r, 2000));
            }
          }
          if(typeof window.Adsgram === 'undefined') throw new Error("Adsgram not loaded");
          const adCtrl = window.Adsgram.init({ blockId: slot.id ? String(slot.id) : '23393' });
          let res = await adCtrl.show();
          if(!res || res.done !== true) throw new Error("Ad Closed");
          success = true;
        }

        if(success) {
          let newBal = (appState.user.balance || 0) + reward;
          let newEarn = (appState.user.totalEarned || 0) + reward;
          let newAds = appState.user.dailyAds || {};
          newAds[i] = (newAds[i] || 0) + 1;
          
          await db.ref('users/' + appState.user.id).update({ 
            balance: newBal, totalEarned: newEarn, dailyAds: newAds 
          });
          toast('Success! +' + reward);
        }
      } catch(e) { 
        console.error('Ad error:', e);
        toast(e.message || 'Failed/Ad Blocked'); 
      } finally { 
        slotLocks[i] = false; 
      }
    }

