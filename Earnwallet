        <div style="font-size:1.2rem;font-weight:900;color:#fff;margin-bottom:5px;">${message}</div>
        <div style="display:flex;justify-content:center;gap:15px;margin:20px 0;">
          <div style="background:rgba(0,184,148,.15);padding:12px 20px;border-radius:12px;"><div style="font-size:1.3rem;font-weight:900;color:#00b894;">${correct}</div><div style="font-size:.7rem;color:#bbb;">সঠিক</div></div>
          <div style="background:rgba(255,71,87,.15);padding:12px 20px;border-radius:12px;"><div style="font-size:1.3rem;font-weight:900;color:#ff4757;">${wrong}</div><div style="font-size:.7rem;color:#bbb;">ভুল</div></div>
