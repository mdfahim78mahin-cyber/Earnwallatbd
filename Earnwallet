    async function submitPromoRequest(){
      const link = document.getElementById('promoLink').value.trim();
      const note = document.getElementById('promoNote').value.trim();
      const sender = document.getElementById('promoSender').value.trim();
      const trx = document.getElementById('promoTrx').value.trim();
      
      if(!promoState.platform || !promoState.service) return toast('Platform & Service select করুন');
      if(!promoState.quantity || promoState.quantity < 10) return toast('Minimum quantity 10');
      if(!link) return toast('Link দিন');
      if(!sender || sender.length < 11) return toast('সঠিক নাম্বার দিন');
      if(!trx || trx.length < 6) return toast('সঠিক Trx ID দিন');
      
      const amount = calculatePromoPrice(promoState.quantity);
      const serviceKey = promoState.platform + '_' + promoState.service;
      
      try {
        const promoId = 'P' + Date.now();
        await db.ref('promotions/' + promoId).set({
          userId: String(appState.user.id),
          userName: appState.user.name || 'User',
          userPhoto: appState.user.photo || '',
          platform: promoState.platform,
          service: serviceKey,
          quantity: promoState.quantity,
          link: link,
          note: note,
          amount: amount,
          method: promoState.method,
          senderNumber: sender,
          transactionId: trx,
          status: 'pending',
          timestamp: Date.now()
        });
        
        toast('✅ Promotion Request Submitted!');
        closePromoForm();
        renderMyPromotions();
      } catch(e) {
        toast('❌ Error: ' + e.message);
      }
    }

