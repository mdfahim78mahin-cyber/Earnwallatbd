              <div class="ref-msg-badge" style="background:rgba(255,255,255,.2);">VERIFICATION</div>
              <div class="ref-msg-title">Verification দরকার</div>
              <div class="ref-msg-sub">Withdraw করার জন্য প্রথমে আপনার Account Verify করতে হবে</div>
              <div class="ref-msg-info" style="background:rgba(255,255,255,.15);"><i class="fas fa-info-circle"></i> Home page এ "Get Verified" banner ক্লিক করে Verify করুন</div>
              <button class="ref-msg-btn" onclick="closeRefMsg(); setTimeout(()=>switchTab('home', document.querySelector('.nav-item-wrap:nth-child(1) .nav-item')), 300)"><i class="fas fa-check-circle"></i> Verify করুন</button>
              <button class="ref-msg-close" onclick="closeRefMsg()">Cancel</button>
            </div>
          </div>`;
      }
      
      overlay.classList.add('show');
      document.getElementById('app').classList.add('blurred');
    }

    function closeRefMsg(){
      document.getElementById('refMsgOverlay').classList.remove('show');
      document.getElementById('app').classList.remove('blurred');
    }

    function goToReferral(){
      closeRefMsg();
      switchTab('referral', document.querySelector('.nav-item-wrap:nth-child(2) .nav-item'));
    }

    function getRefLink() { 
      const botUsername = (appState.config.botUsername || "bot").replace('@', '');
      return `https://t.me/${botUsername}/app?startapp=${appState.user.id}`; 
    }
    function copyLink() { navigator.clipboard.writeText(getRefLink()); toast('Link Copied!'); }
    function shareLink() {
      const url = `https://t.me/share/url?url=${encodeURIComponent(getRefLink())}&text=Join%20Now!`;
      if(tg && tg.openTelegramLink) tg.openTelegramLink(url); else window.open(url, '_blank');
    }
    function openTutorial() { 
      const yt = appState.config.tutorialLink || '';
      const fb = appState.config.tutorialLinkFb || '';
      const tt = appState.config.tutorialLinkTikTok || '';
      const link = yt || fb || tt;
      if(link) openTutorialLink(link);
      else toast('No tutorial available');
    }
    function openSupport() { 
      if(appState.config.supportLink) window.open(appState.config.supportLink, '_blank'); 
    }

    window.onload = () => {
      document.getElementById('u-name').innerText = tgUser.first_name || 'User';
      document.getElementById('u-id').innerText = 'ID: ' + tgUser.id;
      if(tgUser.photo_url) document.getElementById('u-img').src = tgUser.photo_url;

      let configLoaded = false;
      let userLoaded = false;

      function tryBoot() {
        if (configLoaded && userLoaded && !isBooted) {
          isBooted = true;
          document.getElementById('loader').style.display = 'none';
          document.getElementById('app').style.display = 'block';
          updateTextElements();
          renderAds();
          renderTasks();
          renderQuizSection();
          renderWdHistory();
          if (appState.user.dailyBonusDate !== todayStr()) showBonus();
        }
      }

      db.ref('config').on('value', snap => {
        appState.config = snap.exists() ? snap.val() : {};
        
        if(appState.config.adSlots && Array.isArray(appState.config.adSlots)){
          appState.config.adSlots.forEach(slot => {
            if(slot && slot.network === 'monetag' && slot.id){ ensureZoneLoaded(String(slot.id)); }
          });
        }
        
        configLoaded = true;
        if (isBooted) { updateTextElements(); renderAds(); renderTasks(); renderQuizSection(); }
        tryBoot();
      }, err => { appState.config = {}; configLoaded = true; tryBoot(); });

      loadSlides();
      loadPromoConfig();

      const userRef = db.ref('users/' + tgUser.id);

      (async () => {
        try {
          const snap = await userRef.once('value');
          const today = todayStr();

          if (!snap.exists()) {
            const newUser = {
              id: tgUser.id, name: tgUser.first_name || 'User', photo: tgUser.photo_url || '',
              balance: 0, totalEarned: 0, referrals: 0, dailyAds: {}, taskHistory: {},
              lastActive: today, dailyBonusDate: '', verified: false,
              quizPlayedDate: '', quizPlayedToday: 0, quizCorrectCount: 0, withdrawUnlocked: false
            };
            try { await userRef.set(newUser); } catch (e) { console.error(e); }
            appState.user = newUser;

            let refBy = (tg && tg.initDataUnsafe && tg.initDataUnsafe.start_param) ? tg.initDataUnsafe.start_param : null;
            if (!refBy) {
              const urlParams = new URLSearchParams(window.location.search);
              refBy = urlParams.get('tgWebAppStartParam') || urlParams.get('startapp');
            }

            if (refBy && String(refBy) !== String(tgUser.id)) {
              try {
                const cSnap = await db.ref('config').once('value');
                const rBonus = (cSnap.exists() && cSnap.val().refBonus) ? Number(cSnap.val().refBonus) : 5;
                const refSnap = await db.ref('users/' + refBy).once('value');
                if (refSnap.exists()) {
                  const r = refSnap.val();
                  await db.ref('users/' + refBy).update({
                    referrals: (r.referrals || 0) + 1,
                    balance: (r.balance || 0) + rBonus,
                    totalEarned: (r.totalEarned || 0) + rBonus
                  });
                }
              } catch (e) { console.error(e); }
            }
          } else {
            appState.user = snap.val();
          }

          userRef.on('value', async liveSnap => {
            if (!liveSnap.exists()) return;
            appState.user = liveSnap.val();
            if (!appState.user.dailyAds) appState.user.dailyAds = {};
            if (!appState.user.taskHistory) appState.user.taskHistory = {};

            const total = getTotalRefReq();
            if(total > 0 && !appState.user.withdrawUnlocked && (appState.user.referrals || 0) >= total){
              try { await userRef.update({ withdrawUnlocked: true, withdrawUnlockedAt: Date.now() }); } catch(e) { console.error(e); }
            }

            const today2 = todayStr();
            if (appState.user.lastActive !== today2) {
              try {
                await userRef.update({ dailyAds: {}, lastActive: today2 });
                appState.user.dailyAds = {};
              } catch (e) { console.error(e); }
            }

            userLoaded = true;
            updateTextElements();
            renderAds();
            renderTasks();
            renderQuizSection();
            renderWdHistory();
            tryBoot();
          }, err => { userLoaded = true; tryBoot(); });

          setTimeout(() => { userLoaded = true; tryBoot(); }, 3000);
        } catch (err) {
          userLoaded = true; configLoaded = true;
          if (!isBooted) {
            isBooted = true;
            document.getElementById('loader').style.display = 'none';
            document.getElementById('app').style.display = 'block';
          }
        }
      })();
    };

    async function loadLeaderboard() {
      const sym = appState.config.currencySymbol || "TK";
      const snap = await db.ref('users').orderByChild('balance').limitToLast(10).once('value');
      let users = []; 
      snap.forEach(child => { if(child.val().balance > 0) users.push(child.val()); });
      users.reverse();
      
      let p1 = '', p2 = '', p3 = '', listHtml = '';
      users.forEach((u, i) => {
        let pic = u.photo || 'https://via.placeholder.com/100';
        let name = u.name ? u.name.substring(0, 10) : 'User';
        let bal = Number(u.balance || 0).toFixed(2);
        let refs = u.referrals || 0;
        let vIcon = u.verified ? ' <i class="fas fa-check-circle" style="color:#00b894;font-size:.7rem;"></i>' : '';
        let safeImg = `onerror="this.src='https://via.placeholder.com/100'"`;
        let statsHtml = `<div class="rank-stats-col"><div class="rank-badge badge-bal">${bal} ${sym}</div><div class="rank-badge badge-ref"><i class="fas fa-users"></i> ${refs} Refs</div></div>`;
        
        if(i === 0) p1 = `<div class="podium-item rank-1"><i class="fas fa-crown crown"></i><img src="${pic}" class="podium-img" ${safeImg}><div class="rank-name">${name}${vIcon}</div>${statsHtml}</div>`;
        else if(i === 1) p2 = `<div class="podium-item rank-2"><i class="fas fa-crown crown"></i><img src="${pic}" class="podium-img" ${safeImg}><div class="rank-name">${name}${vIcon}</div>${statsHtml}</div>`;
        else if(i === 2) p3 = `<div class="podium-item rank-3"><i class="fas fa-crown crown"></i><img src="${pic}" class="podium-img" ${safeImg}><div class="rank-name">${name}${vIcon}</div>${statsHtml}</div>`;
        else listHtml += `<div class="leader-row"><div class="leader-left"><div class="rank-num">#${i+1}</div><img src="${pic}" ${safeImg}><span>${name}${vIcon}</span></div><div class="leader-right-stats"><span class="leader-right-bal">${bal} ${sym}</span><span class="leader-right-ref"><i class="fas fa-users"></i> ${refs} Refs</span></div></div>`;
      });
      
      document.getElementById('podium-area').innerHTML = p2 + p1 + p3;
      document.getElementById('leader-list-area').innerHTML = listHtml;
    }
  </script>
</body>
</html>
