    let quizSession = { quizzes: [], currentIndex: 0, correct: 0, wrong: 0, totalReward: 0 };
    let currentQuiz = null;
    let currentQuizKey = null;
    let quizTimerInterval = null;
    let quizTimeLeft = 30;

    async function startQuizSession(){
      const today = todayStr();
      const todayPlayed = (appState.user.quizPlayedDate === today) ? (appState.user.quizPlayedToday || 0) : 0;
      const dailyLimit = Number(appState.config.quizDailyLimit || 3);
      
      if(todayPlayed >= dailyLimit){ toast('আজকের লিমিট শেষ!'); return; }
      
      const snap = await db.ref('quizzes').orderByChild('date').equalTo(today).once('value');
      if(!snap.exists()){ toast('আজকের কুইজ এখনো যোগ করা হয়নি!'); return; }
      
      const quizzes = [];
      snap.forEach(child => { quizzes.push({ key: child.key, ...child.val() }); });
      quizzes.sort(() => Math.random() - 0.5);
      const remaining = dailyLimit - todayPlayed;
      quizSession.quizzes = quizzes.slice(0, remaining);
      quizSession.currentIndex = 0;
      quizSession.correct = 0;
      quizSession.wrong = 0;
      quizSession.totalReward = 0;
      showQuizQuestion();
    }

    function showQuizQuestion(){
      if(quizSession.currentIndex >= quizSession.quizzes.length){ showQuizSummary(); return; }
      
      currentQuiz = quizSession.quizzes[quizSession.currentIndex];
      currentQuizKey = currentQuiz.key;
      
      document.getElementById('quizProgressText').innerText = `${quizSession.currentIndex + 1} / ${quizSession.quizzes.length}`;
      
      const cat = currentQuiz.category || 'GK';
      const catNames = { 'GK':'সাধারণ জ্ঞান', 'Math':'গণিত', 'English':'ইংরেজি', 'Science':'বিজ্ঞান', 'History':'ইতিহাস', 'Sports':'খেলাধুলা' };
      document.getElementById('quizCategoryBadge').innerText = catNames[cat] || cat;
      document.getElementById('quizCategoryBadge').style.display = 'inline-block';
      document.getElementById('quizQuestionText').innerText = currentQuiz.question;
      
      const options = [
        { key: 'A', text: currentQuiz.optA },
        { key: 'B', text: currentQuiz.optB },
        { key: 'C', text: currentQuiz.optC },
        { key: 'D', text: currentQuiz.optD }
      ];
      
      let html = '';
      options.forEach(o => {
        html += `<button onclick="answerQuiz('${o.key}')" class="quiz-opt-btn" style="background:rgba(255,255,255,.06);border:2px solid rgba(255,255,255,.12);color:#fff;padding:14px;border-radius:12px;font-weight:700;font-size:.9rem;cursor:pointer;text-align:left;font-family:inherit;display:flex;align-items:center;gap:10px;"><span style="background:rgba(108,92,231,.4);color:#fff;width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:.8rem;flex-shrink:0;">${o.key}</span><span>${o.text}</span></button>`;
      });
      
      document.getElementById('quizOptions').innerHTML = html;
      document.getElementById('quizOptions').style.display = 'flex';
      document.getElementById('quizResult').style.display = 'none';
      document.getElementById('quizTimerWrap').style.display = 'block';
      
      startQuizTimer();
      
      document.getElementById('quizOverlay').classList.add('show');
      document.getElementById('app').classList.add('blurred');
    }

    function startQuizTimer(){
      if(quizTimerInterval) clearInterval(quizTimerInterval);
      quizTimeLeft = Number(appState.config.quizTime || 30);
      const total = quizTimeLeft;
      const circle = document.getElementById('timerCircle');
      const timeEl = document.getElementById('quizTimeLeft');
      timeEl.innerText = quizTimeLeft;
      timeEl.style.color = '#facc15';
      circle.style.stroke = '#facc15';
      circle.style.strokeDashoffset = '0';
      
      quizTimerInterval = setInterval(() => {
        quizTimeLeft--;
        timeEl.innerText = quizTimeLeft;
        circle.style.strokeDashoffset = 188.5 * (1 - quizTimeLeft / total);
        if(quizTimeLeft <= 10){ timeEl.style.color = '#ff4757'; circle.style.stroke = '#ff4757'; }
        if(quizTimeLeft <= 0){ clearInterval(quizTimerInterval); answerQuiz('TIMEUP'); }
      }, 1000);
    }

    async function answerQuiz(selected){
      if(quizTimerInterval) clearInterval(quizTimerInterval);
      
      const isCorrect = selected === currentQuiz.correct;
      let reward = 0;
      if(isCorrect){ reward = Number(currentQuiz.reward || appState.config.quizReward || 5); quizSession.correct++; quizSession.totalReward += reward; }
      else { quizSession.wrong++; }
      
      document.querySelectorAll('.quiz-opt-btn').forEach(btn => {
        btn.disabled = true; btn.style.cursor = 'not-allowed';
        const btnKey = btn.querySelector('span').innerText;
        if(btnKey === currentQuiz.correct){ btn.style.background = 'rgba(0,184,148,.25)'; btn.style.borderColor = '#00b894'; }
        else if(btnKey === selected){ btn.style.background = 'rgba(255,71,87,.25)'; btn.style.borderColor = '#ff4757'; }
      });
      
      document.getElementById('quizTimerWrap').style.display = 'none';
      const resultDiv = document.getElementById('quizResult');
      resultDiv.style.display = 'block';
      
      if(selected === 'TIMEUP'){
        resultDiv.innerHTML = `<i class="fas fa-clock" style="font-size:3rem;color:#ff4757;margin-bottom:10px;"></i><div style="font-size:1rem;font-weight:800;color:#fff;">⏰ সময় শেষ!</div>`;
      } else if(isCorrect){
        resultDiv.innerHTML = `<i class="fas fa-check-circle" style="font-size:3rem;color:#00b894;margin-bottom:10px;"></i><div style="font-size:1rem;font-weight:800;color:#fff;">সঠিক! 🎉</div><div style="font-size:1.1rem;color:#facc15;font-weight:900;margin-top:5px;">+${reward} TK</div>`;
      } else {
        resultDiv.innerHTML = `<i class="fas fa-times-circle" style="font-size:3rem;color:#ff4757;margin-bottom:10px;"></i><div style="font-size:1rem;font-weight:800;color:#fff;">ভুল উত্তর ❌</div>`;
      }
      
      try {
        const today = todayStr();
        const todayPlayed = (appState.user.quizPlayedDate === today) ? (appState.user.quizPlayedToday || 0) : 0;
        await db.ref('users/' + appState.user.id).update({
          quizPlayedDate: today,
          quizPlayedToday: todayPlayed + 1,
          quizCorrectCount: (appState.user.quizCorrectCount || 0) + (isCorrect ? 1 : 0),
          balance: (appState.user.balance || 0) + reward,
          totalEarned: (appState.user.totalEarned || 0) + reward
        });
        
        await db.ref('quizResults/' + 'R_' + Date.now() + '_' + appState.user.id).set({
          userId: String(appState.user.id), userName: appState.user.name || 'User',
          photo: appState.user.photo || '', quizId: currentQuizKey,
          quizQuestion: currentQuiz.question, answer: selected,
          correctAnswer: currentQuiz.correct, isCorrect: isCorrect,
          reward: reward, date: today, timestamp: Date.now()
        });
        
        if(isCorrect) toast('🎉 সঠিক! +' + reward + ' TK');
      } catch(e){ console.error(e); }
      
      setTimeout(() => {
        quizSession.currentIndex++;
        if(quizSession.currentIndex >= quizSession.quizzes.length) showQuizSummary();
        else showQuizQuestion();
      }, 2000);
    }

    function showQuizSummary(){
      const total = quizSession.quizzes.length;
      const correct = quizSession.correct;
      const wrong = quizSession.wrong;
      const earned = quizSession.totalReward;
      const percent = total > 0 ? Math.round((correct / total) * 100) : 0;
      
      let emoji = '😊', message = 'ভালো করেছেন!';
      if(percent === 100){ emoji = '🏆'; message = 'অসাধারণ!'; }
      else if(percent >= 70){ emoji = '🎉'; message = 'দুর্দান্ত!'; }
      else if(percent >= 50){ emoji = '👍'; message = 'ভালো!'; }
      
      document.getElementById('quizTimerWrap').style.display = 'none';
      document.getElementById('quizOptions').style.display = 'none';
      document.getElementById('quizQuestionText').innerHTML = '';
      document.getElementById('quizCategoryBadge').style.display = 'none';
