      const data = (promoState.prices[promoState.platform] && promoState.prices[promoState.platform][promoState.service]) || { amount: 50, quantity: 100 };
      const baseAmount = data.amount || 50;
      const baseQuantity = data.quantity || 100;
      
      promoState.quantity = baseQuantity;
      
      const quickQtys = [
        baseQuantity,
        baseQuantity * 2,
        baseQuantity * 5,
        baseQuantity * 10,
        baseQuantity * 20,
        baseQuantity * 50
      ];
      
      let qHtml = `
