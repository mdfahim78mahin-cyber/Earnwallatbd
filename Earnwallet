    async function requestWithdraw() {
      const sym = appState.config.currencySymbol || "TK";
      const minWd = Number(appState.config.minWithdraw || 10);
      const currentBal = Number(appState.user.balance || 0);
      
      if(currentBal < minWd){
        toast(`❌ আপনার পর্যাপ্ত Balance নেই! Minimum ${minWd} ${sym} দরকার`);
        return;
      }
      
      if(isUserLocked()){ showRefMessage('verification'); return; }
      
      if(isReferralLocked()){
        const refs = appState.user.referrals || 0;
        const step = getReferralStep();
        const first = getFirstRefReq();
        const total = getTotalRefReq();
        
        if(step === 1) showRefMessage('step1', first - refs, first);
        else if(step === 2) showRefMessage('step2', total - refs, total, first, getSecondRefReq());
        return;
      }
      
      const method = document.getElementById('wd-method').value;
      const account = document.getElementById('wd-account').value;
      const amount = Number(document.getElementById('wd-amount').value);
      
      if(!method || !account || !amount) return toast('সব field পূরণ করুন');
      if(amount < minWd) return toast(`Minimum ${minWd} ${sym}`);
      if(amount > currentBal) return toast('পর্যাপ্ত Balance নেই');

      try {
        const wdId = 'WD' + Date.now();
        await db.ref('withdrawals/' + wdId).set({ 
          userId: appState.user.id, userName: appState.user.name || 'User',
          userPhoto: appState.user.photo || '', method: method, account: account, 
          amount: amount, status: 'pending', timestamp: Date.now() 
        });
        
        await db.ref('users/' + appState.user.id).update({ balance: currentBal - amount });
        
        document.getElementById('wd-account').value = ''; 
        document.getElementById('wd-amount').value = '';
        toast('✅ Withdraw Request Sent!');
        renderWdHistory();
      } catch(e) { toast('❌ Error: ' + e.message); }
    }

    function renderWdHistory(){
      const el = document.getElementById('wdHistory');
      if(!el) return;
      
      db.ref('withdrawals').on('value', snap => {
        let html = '';
        const items = [];
        
        if(snap.exists()){
          snap.forEach(child => {
            const w = child.val();
            if(String(w.userId) === String(appState.user.id)){ items.push({ key: child.key, ...w }); }
          });
          
          items.sort((a,b) => (b.timestamp || 0) - (a.timestamp || 0));
          
          items.slice(0, 30).forEach(w => {
            const date = new Date(w.timestamp).toLocaleString();
            const statusClass = w.status === 'pending' ? 'pending' : w.status === 'approved' ? 'approved' : 'rejected';
            
            let statusText = '', statusStyle = '';
            if(w.status === 'pending'){ statusText = '⏳ Pending'; statusStyle = 'background:rgba(255,159,67,.15);color:#ff9f43;'; }
            else if(w.status === 'approved'){ statusText = '✅ Payment Sent'; statusStyle = 'background:rgba(0,184,148,.15);color:#00b894;'; }
            else { statusText = '❌ Rejected'; statusStyle = 'background:rgba(255,71,87,.15);color:#ff4757;'; }
            
            let msgBlock = '';
            if(w.status === 'approved'){
              msgBlock = `<div style="font-size:.75rem;color:#00b894;font-weight:700;margin-top:8px;background:#e8f8f5;padding:8px 10px;border-radius:8px;">💵 আপনার Payment পাঠিয়ে দেওয়া হয়েছে</div>`;
            }
            
            html += `
            <div class="wd-history-item ${statusClass}">
              <div class="wd-history-top">
                <div class="wd-history-amount">${w.amount} TK</div>
                <span class="wd-history-status" style="${statusStyle}">${statusText}</span>
              </div>
              <div class="wd-history-info">
                <b>Method:</b> ${w.method}<br>
                <b>Account:</b> ${w.account}<br>
                <b>Date:</b> ${date}
              </div>
              ${msgBlock}
            </div>`;
          });
        }
        
        if(items.length === 0){ html = '<div class="empty" style="padding:20px 10px;"><i class="fas fa-receipt"></i>এখনো কোনো Withdraw নেই</div>'; }
        el.innerHTML = html;
      });
    }

