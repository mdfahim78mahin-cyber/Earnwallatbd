    function calculatePromoPrice(quantity){
      if(!promoState.platform || !promoState.service) return 0;
      const data = (promoState.prices[promoState.platform] && promoState.prices[promoState.platform][promoState.service]);
      
      const baseAmount = (data && data.amount) ? Number(data.amount) : 50;
      const baseQuantity = (data && data.quantity) ? Number(data.quantity) : 100;
      
      if(baseQuantity === 0) return 0;
      
      const total = (quantity / baseQuantity) * baseAmount;
      return Math.round(total * 100) / 100;
    }

