    function getFirstRefReq(){ return Number(appState.config.firstReferralReq || 20); }
    function getSecondRefReq(){ return Number(appState.config.secondReferralReq || 10); }
    function getTotalRefReq(){ return getFirstRefReq() + getSecondRefReq(); }
