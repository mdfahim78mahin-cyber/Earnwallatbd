    function renderSlides(){
      const track = document.getElementById('slideBannerTrack');
      const dotsEl = document.getElementById('slideDots');
      const container = document.getElementById('slideBannerContainer');
      if(!track || !dotsEl || !container) return;
      
      if(activeSlides.length === 0){ container.classList.remove('active'); return; }
      container.classList.add('active');
      
      let slidesHtml = '';
      activeSlides.forEach(s => {
        slidesHtml += `
          <div class="slide-banner-slide" style="background:${s.color};">
            <div class="slide-banner-content">
              <div class="slide-banner-icon">${s.icon}</div>
              <div class="slide-banner-text">
                <div class="slide-banner-title">${s.title}</div>
                <div class="slide-banner-sub">${s.subtitle}</div>
              </div>
            </div>
          </div>`;
      });
      track.innerHTML = slidesHtml;
      
      let dotsHtml = '';
      activeSlides.forEach((_, i) => { dotsHtml += `<span class="slide-dot ${i===0?'active':''}"></span>`; });
      dotsEl.innerHTML = dotsHtml;
      
      currentSlide = 0;
      track.style.transform = 'translateX(0)';
      initSlideBanner();
    }

    function initSlideBanner(){
      const track = document.getElementById('slideBannerTrack');
      const dots = document.querySelectorAll('.slide-dot');
      if(!track) return;
      
      if(slideInterval) clearInterval(slideInterval);
      
      slideInterval = setInterval(() => {
        currentSlide = (currentSlide + 1) % activeSlides.length;
        updateSlide();
      }, 3500);
      
      let startX = 0, isDragging = false;
      
      track.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
        isDragging = true;
        if(slideInterval) clearInterval(slideInterval);
      }, {passive: true});
      
      track.addEventListener('touchend', (e) => {
        if(!isDragging) return;
        isDragging = false;
        const diff = startX - e.changedTouches[0].clientX;
        
        if(Math.abs(diff) > 50){
          if(diff > 0){ currentSlide = (currentSlide + 1) % activeSlides.length; }
          else { currentSlide = (currentSlide - 1 + activeSlides.length) % activeSlides.length; }
          updateSlide();
        }
        
        slideInterval = setInterval(() => {
          currentSlide = (currentSlide + 1) % activeSlides.length;
          updateSlide();
        }, 3500);
      }, {passive: true});
      
      dots.forEach((dot, i) => { dot.addEventListener('click', () => { currentSlide = i; updateSlide(); }); });
    }

    function updateSlide(){
      const track = document.getElementById('slideBannerTrack');
      const dots = document.querySelectorAll('.slide-dot');
      if(!track) return;
      track.style.transform = `translateX(-${currentSlide * 100}%)`;
      dots.forEach((dot, i) => {
        if(i === currentSlide) dot.classList.add('active');
        else dot.classList.remove('active');
      });
    }

    function ensureZoneLoaded(zoneId){
      if(!zoneId || zoneId === 'none') return;
      if(PRELOADED_ZONES.includes(String(zoneId))) return;
      if(document.querySelector(`script[data-zone="${zoneId}"]`)) return;
      const sc = document.createElement('script');
      sc.src = '//libtl.com/sdk.js';
      sc.dataset.zone = String(zoneId);
      sc.dataset.sdk = 'show_' + zoneId;
      document.body.appendChild(sc);
    }

    function waitForSDK(zoneId, maxWait = 5000){
      return new Promise((resolve) => {
        const start = Date.now();
        const fnName = 'show_' + zoneId;
        const check = () => {
          if(typeof window[fnName] === 'function') return resolve(true);
          if(Date.now() - start > maxWait) return resolve(false);
          setTimeout(check, 300);
        };
        check();
      });
    }

