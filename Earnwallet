    function getReferralStep(){
      if(isWithdrawPermanentlyUnlocked()) return 3;
      const refs = appState.user.referrals || 0;
      const first = getFirstRefReq();
      const total = getTotalRefReq();
      if(refs >= total) return 3;
      if(refs >= first) return 2;
      return 1;
    }

    function isReferralLocked(){
      if(isWithdrawPermanentlyUnlocked()) return false;
      const total = getTotalRefReq();
      if(total === 0) return false;
      return (appState.user.referrals || 0) < total;
    }

